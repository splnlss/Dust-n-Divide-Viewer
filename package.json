{
    "name": "@splnlss/dust-n-divide-viewer",
    "version": "0.1.1",
    "type": "module",
    "description": "Vanilla WebGPU viewer for PlayCanvas streamed SOG gaussian splats, tuned for Quest 3 VR",
    "repository": {
