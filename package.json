{
    "name": "@splnlss/dust-n-divide-viewer",
    "version": "0.2.0",
    "type": "module",
    "description": "Vanilla WebGPU viewer for PlayCanvas streamed SOG gaussian splats, tuned for Quest 3 VR",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/splnlss/Dust-n-Divide-Viewer.git"
    },
    "exports": {
        "./*": "./src/*"
    },
    "files": [
        "src"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "smoke": "node scripts/smoke.mjs",
        "smoke:three": "node scripts/smoke-three.mjs"
    },
    "peerDependencies": {
        "three": "~0.187.0"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "puppeteer-core": "^24.0.0",
        "three": "0.187.0",
        "vite": "^8.3.8"
    },
    "packageManager": "pnpm@10.18.3"
}
